        <mxCell id="D" value="Durable Storage &amp;amp; Capacity Guard (SQLite WAL OSS / Pluggable Seam)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#fffbeb;strokeColor=#d97706;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;container=1;collapsible=0;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1">
