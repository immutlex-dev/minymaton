        <mxCell id="lt4" value="Bearer credential &amp;amp; capacity state check" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="LG">
          <mxGeometry x="95" y="165" width="330" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="L" value="Parked lifecycle &#x2014; one helper per handle; handle events before ACK; no automatic re-arm" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#f8fafc;strokeColor=#475569;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=15;container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="1000" width="2470" height="370" as="geometry"/>
        </mxCell>
        <mxCell id="l_start" value="&lt;b&gt;1. Agent yields &#x2192; launch background waiter&lt;/b&gt;&lt;br&gt;Native Rust &lt;i&gt;minymaton-wait&lt;/i&gt; or Python 3 &lt;i&gt;minymaton-wait.py&lt;/i&gt;;&lt;br&gt;sessionless MCP 2026-07-28 headers + &lt;i&gt;_meta&lt;/i&gt;;&lt;br&gt;&lt;i&gt;receive(wait: true)&lt;/i&gt;, optional handled-batch ACK;&lt;br&gt;explicit &lt;i&gt;--url / MINYMATON_URL / --config&lt;/i&gt;; no initialize" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=13;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="L">
          <mxGeometry x="25" y="55" width="450" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="l_wait" value="&lt;b&gt;2. Server parks receive on explicit events&lt;/b&gt;&lt;br&gt;Signals commit / owner watch channels; outside QueueStore lock;&lt;br&gt;WaitGuard enters process-local &lt;i&gt;waiting&lt;/i&gt; observation;&lt;br&gt;&lt;i&gt;publish(ack)&lt;/i&gt; / &lt;i&gt;receive(max_events: 0, ack)&lt;/i&gt;&lt;br&gt;preserves parked owner (omit wait + max_bytes)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d1fae5;strokeColor=#059669;fontSize=13;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="L">
          <mxGeometry x="620" y="55" width="500" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="l_release" value="&lt;b&gt;3. QueueStore::release rechecks owner before delivery&lt;/b&gt;&lt;br&gt;Check subscription exists + owner_generation in same tx;&lt;br&gt;only current owner records delivery attempt;&lt;br&gt;return complete JSON-RPC response (JSON or SSE);&lt;br&gt;helper exits &lt;b&gt;0&lt;/b&gt; with unacknowledged batch on stdout" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d1fae5;strokeColor=#059669;fontSize=13;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="L">
          <mxGeometry x="1260" y="55" width="500" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="l_handle" value="&lt;b&gt;4. Supporting harness observes command completion&lt;/b&gt;&lt;br&gt;Native task watcher wakes idle agent; MCP alone cannot;&lt;br&gt;handle events, deduplicate by batch_id, then ACK;&lt;br&gt;re-parking when idle remains agent-owned;&lt;br&gt;at-least-once delivery, not exactly-once handling" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=13;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="L">
          <mxGeometry x="1900" y="55" width="510" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="l_cancel" value="&lt;b&gt;Disconnect / cancellation &#x2192; WaitGuard drop&lt;/b&gt;&lt;br&gt;Request socket closes or MCP cancellation fires;&lt;br&gt;&lt;i&gt;context.ct.cancelled()&lt;/i&gt; drops parked receive;&lt;br&gt;guard drop updates active-count watch + waiting;&lt;br&gt;hard kill needs no helper finally / HTTP cleanup" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=13;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="L">
          <mxGeometry x="620" y="230" width="500" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="l_terminal" value="&lt;b&gt;Terminal nonzero outcomes &#x2014; never auto-relaunch&lt;/b&gt;&lt;br&gt;&lt;b&gt;3&lt;/b&gt; superseded; &lt;b&gt;4&lt;/b&gt; batch gone; &lt;b&gt;5&lt;/b&gt; subscription missing;&lt;br&gt;&lt;b&gt;6&lt;/b&gt; bounds; &lt;b&gt;7&lt;/b&gt; HTTP / EOF; &lt;b&gt;1&lt;/b&gt; config / protocol / domain;&lt;br&gt;&lt;b&gt;130&lt;/b&gt; Ctrl+C; JSON stderr (&lt;b&gt;2&lt;/b&gt; argument usage instead);&lt;br&gt;resolve cause / ownership; avoid waiter takeover livelock" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffedd5;strokeColor=#d97706;fontSize=13;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="L">
          <mxGeometry x="1260" y="230" width="500" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="l_limits" value="&lt;b&gt;Event-driven boundary&lt;/b&gt;&lt;br&gt;No sleeps, polling, retry timers or automatic re-arm;&lt;br&gt;foreground MCP receives remain client-timeout-bound;&lt;br&gt;half-open TCP without FIN/RST may block indefinitely;&lt;br&gt;&lt;i&gt;waiting&lt;/i&gt; does not prove a remote client is alive" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=13;verticalAlign=middle;spacing=8;fontFamily=Helvetica;" vertex="1" parent="L">
          <mxGeometry x="1900" y="230" width="510" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="e_l_request" value="tools/call" style="html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;fontFamily=Helvetica;strokeColor=#1f2937;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="L" source="l_start" target="l_wait">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_l_commit" value="batch ready" style="html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;fontFamily=Helvetica;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="L" source="l_wait" target="l_release">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_l_complete" value="exit + stdout" style="html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;fontFamily=Helvetica;strokeColor=#2563eb;strokeWidth=2;dashed=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="L" source="l_release" target="l_handle">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_l_cancel" value="EOF / cancel" style="html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;fontFamily=Helvetica;strokeColor=#7c3aed;strokeWidth=2;dashed=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="L" source="l_wait" target="l_cancel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_l_release_terminal" value="stale / failure" style="html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;fontFamily=Helvetica;strokeColor=#d97706;strokeWidth=2;endArrow=block;endFill=1;exitX=0.8;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="L" source="l_release" target="l_terminal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_l_terminal" value="superseded / error" style="html=1;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;fontFamily=Helvetica;strokeColor=#d97706;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.9;entryX=0.5;entryY=0;" edge="1" parent="L" source="l_wait" target="l_terminal">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1190" y="163"/>
              <mxPoint x="1190" y="205"/>
              <mxPoint x="1510" y="205"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
