        <mxCell id="d_schema" value="&lt;b&gt;QueueStore / QueueReader State&lt;/b&gt; (&lt;i&gt;store.rs&lt;/i&gt;)&lt;br&gt;&#x2022; &lt;b&gt;streams&lt;/b&gt; &amp;amp; &lt;b&gt;subscriptions&lt;/b&gt; (&lt;i&gt;committed_sequence, owner_generation, metadata&lt;/i&gt;)&lt;br&gt;&#x2022; &lt;b&gt;events&lt;/b&gt; (&lt;i&gt;sequence, payload, sender_label, recipient_label&lt;/i&gt;)&lt;br&gt;&#x2022; &lt;b&gt;batches&lt;/b&gt;, &lt;b&gt;batch_aliases&lt;/b&gt;, &lt;b&gt;publishes&lt;/b&gt;&lt;br&gt;&#x2022; &lt;b&gt;agents&lt;/b&gt; &amp;amp; &lt;b&gt;agent_subscriptions&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fef3c7;strokeColor=#d97706;fontSize=12;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="D">
          <mxGeometry x="25" y="45" width="390" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="d_db" value="&lt;b&gt;minymaton.sqlite3 (Deployed OSS, mode 0600)&lt;/b&gt;&lt;br&gt;&lt;i&gt;journal_mode = WAL &#xB7; synchronous = FULL&lt;/i&gt;&lt;br&gt;&lt;i&gt;foreign_keys = ON &#xB7; busy_timeout = 0&lt;/i&gt;&lt;br&gt;&lt;br&gt;Bundled &lt;i&gt;Store&lt;/i&gt; + &lt;i&gt;Reader&lt;/i&gt; implement &lt;i&gt;QueueStore&lt;/i&gt; + &lt;i&gt;QueueReader&lt;/i&gt;;&lt;br&gt;&lt;i&gt;Queue::with_backend&lt;/i&gt; seam for other backends" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=14;fillColor=#fef3c7;strokeColor=#d97706;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="D">
          <mxGeometry x="25" y="255" width="390" height="225" as="geometry"/>
        </mxCell>
        <mxCell id="d_ops" value="&lt;b&gt;minymaton-storage-check&lt;/b&gt; &amp;amp; &lt;b&gt;storage.json&lt;/b&gt; (&lt;i&gt;deploy/&lt;/i&gt;)&lt;br&gt;systemd &lt;i&gt;.timer&lt;/i&gt; checks &lt;i&gt;statvfs&lt;/i&gt; available blocks on DB volume;&lt;br&gt;records state in fixed-size &lt;i&gt;storage.json&lt;/i&gt; slot &amp;amp; posts edge-triggered&lt;br&gt;alert when free space &amp;lt; 10% via &lt;i&gt;curl --config -&lt;/i&gt; (URL on stdin)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fef3c7;strokeColor=#d97706;fontSize=12;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" vertex="1" parent="D">
