# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Minymaton' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  pod 'MinymatonCore', :path => './MinymatonCore'
  pod 'MinymatonModule', :path => './MinymatonModule'

  target 'MinymatonTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # fmt 11.0.2's consteval format strings are rejected by Xcode 27 clang;
    # build fmt as C++17 so FMT_USE_CONSTEVAL stays off.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'
      target.build_configurations.each do |bc|
        bc.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end
    end
    # React Native 0.76's Generate Specs phase routes through
    # with-environment.sh, which word-splits its argument and breaks when
    # the project path contains spaces. Invoke script_phases.sh directly
    # with the same environment, fully quoted.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'ReactCodegen'
      target.shell_script_build_phases.each do |phase|
        next unless phase.name.include?('Generate Specs')
        phase.shell_script = <<~'SCRIPT'
          set -e
          pushd "$PODS_ROOT/../" > /dev/null
          RCT_SCRIPT_POD_INSTALLATION_ROOT=$(pwd)
          popd > /dev/null
          export RCT_SCRIPT_RN_DIR="$RCT_SCRIPT_POD_INSTALLATION_ROOT/../node_modules/react-native"
          export RCT_SCRIPT_APP_PATH="$RCT_SCRIPT_POD_INSTALLATION_ROOT/.."
          export RCT_SCRIPT_OUTPUT_DIR="$RCT_SCRIPT_POD_INSTALLATION_ROOT"
          export RCT_SCRIPT_TYPE="withCodegenDiscovery"
          if [ -f "$PODS_ROOT/../.xcode.env" ]; then set -a; . "$PODS_ROOT/../.xcode.env"; set +a; fi
          if [ -f "$PODS_ROOT/../.xcode.env.local" ]; then set -a; . "$PODS_ROOT/../.xcode.env.local"; set +a; fi
          export NODE_BINARY="${NODE_BINARY:-$(command -v node)}"
          "$RCT_SCRIPT_RN_DIR/scripts/react_native_pods_utils/script_phases.sh"
        SCRIPT
      end
    end
  end
end
